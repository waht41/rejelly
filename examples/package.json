{
  "name": "rejelly-examples",
  "version": "0.0.0",
  "description": "Examples for Rejelly framework",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "tsx --import @rejelly/env/setup scripts/run.ts",
    "otlp": "tsx --import @rejelly/env/setup scripts/run.ts --otlp",
    "review": "tsx --import @rejelly/env/setup scripts/run.ts --review",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rejelly/adapter-gemini": "workspace:*",
    "@rejelly/adapter-mcp": "workspace:*",
    "@rejelly/adapter-openai": "workspace:*",
    "@rejelly/core": "workspace:*",
    "@rejelly/env": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "prompts": "^2.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
