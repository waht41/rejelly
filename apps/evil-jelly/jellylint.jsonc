{
  "nodePolicies": {
    "production": {
      "default": true,
      "exclude": ["src/**/__tests__/**/*", "src/**/*.test.*"]
    }
  },
  "nodes": {
    "@spec:tests": {
      "patterns": ["src/**/__tests__/**/*", "src/**/*.test.*"],
      "policies": ["!production"]
    },
    "@cli:entry": ["src/cli/index.ts", "src/cli/entry/*"],
    "@cli:bindings": "src/cli/bindings/**/*",
    "@cli:interactive-shell": "src/cli/interactive-shell/**/*",
    "@cli:conversation-display": "src/cli/conversation-display/**/*",
    "@cli:terminal-ui": "src/cli/terminal-ui/**/*",
    "@cli:message-composer": "src/cli/message-composer/**/*",
    "@cli:unified-conversation": "src/cli/unified-conversation/**/*",
    "@cli:skill-runtime": "src/cli/skill-runtime/**/*",
    "@cli:mcp-runtime": "src/cli/mcp-runtime/**/*",
    "@cli:manager-ui": [
      "src/cli/mcp-manager/**/*",
      "src/cli/memory-manager/**/*",
      "src/cli/skill-manager/**/*"
    ],
    "@cli:runtime": "src/cli/runtime/**/*",
    "@cli:submission-dispatch": "src/cli/submission-dispatch/**/*",
    "@cli:audit-run": "src/cli/entry/audit-run/**/*",
    "@cli:init-run": "src/cli/entry/init-run/**/*",
    "@cli:inspect-run": "src/cli/entry/inspect-run/**/*",
    "@cli:mcp-run": "src/cli/entry/mcp-run/**/*",
    "@cli:skill-run": "src/cli/entry/skill-run/**/*",
    "@cli:unified-run": "src/cli/entry/unified-run/**/*",
    "@cli:model-composition": "src/cli/model-composition/**/*",
    "@cli:operator-decision": "src/cli/operator-decision/**/*",
    "@cli:tool-approval": "src/cli/tool-approval/**/*",
    "@feature:[feat]": "src/features/[feat]/**/*",
    "@domain:[dom]": [
      "src/domains/[dom]/**/*",
      "!src/domains/session/**/*",
      "!src/domains/skills/**/*",
      "!src/domains/memory/**/*"
    ],
    "@domain:skills:definition": "src/domains/skills/definition/**/*",
    "@domain:skills:loader": "src/domains/skills/loader/**/*",
    "@domain:skills:catalog": "src/domains/skills/catalog/**/*",
    "@domain:skills:agent": "src/domains/skills/agent/**/*",
    "@domain:session:model": "src/domains/session/model/**/*",
    "@domain:session:journal": "src/domains/session/journal/**/*",
    "@domain:session:projection": "src/domains/session/projection/**/*",
    "@domain:session:repository": "src/domains/session/repository/**/*",
    "@domain:memory": "src/domains/memory/**/*",
    "@domain:session:recorder": "src/domains/session/recorder/**/*",
    "@shared": "src/shared/**/*",
    "@ext:fs": "node:fs",
    "@ext:ui": ["npm:ink", "npm:react", "npm:zustand"]
  },
  "graph": {
    "runtime_arch": {
      "sequence": {
        "test_access": [
          ["@spec:tests"],
          [
            "@cli:**",
            "@feature:[feat]",
            "@domain:[dom]",
            "@domain:memory",
            "@domain:session:*",
            "@domain:skills:*",
            "@shared",
            "@ext:fs",
            "@ext:ui"
          ]
        ],
        "production_foundation": [
          [
            "@cli:**",
            "@feature:[feat]",
            "@domain:[dom]",
            "@domain:memory",
            "@domain:session:*",
            "@domain:skills:*"
          ],
          ["@shared"]
        ],
        "direct_fs": [
          [
            "@shared",
            "@cli:entry",
            "@cli:mcp-run",
            "@cli:interactive-shell",
            "@cli:message-composer",
            "@cli:tool-approval",
            "@domain:skills:loader",
            "@domain:memory",
            "@domain:session:journal",
            "@domain:session:repository"
          ],
          ["@ext:fs"]
        ],
        "terminal_ui": [
          [
            "@cli:interactive-shell",
            "@cli:conversation-display",
            "@cli:terminal-ui",
            "@cli:message-composer",
            "@cli:manager-ui",
            "@cli:operator-decision",
            "@cli:tool-approval"
          ],
          ["@ext:ui"]
        ]
      },
      "connect": {
        "@cli:bindings": ["@domain:memory"],
        "@cli:audit-run": ["@feature:audit", "@domain:mcp"],
        "@cli:inspect-run": [
          "@feature:inspect",
          "@domain:session:journal",
          "@domain:session:repository"
        ],
        "@cli:mcp-run": ["@domain:mcp"],
        "@cli:skill-run": ["@domain:skills:agent"],
        "@cli:skill-runtime": ["@domain:skills:*"],
        "@cli:unified-run": [
          "@feature:unified",
          "@feature:replay",
          "@domain:session:repository",
          "@domain:session:recorder",
          "@domain:session:projection",
          "@domain:skills:agent",
          "@domain:skills:definition",
          "@domain:mcp",
          "@domain:memory"
        ],
        "@cli:unified-conversation": [
          "@feature:unified",
          "@feature:replay",
          "@domain:mcp",
          "@domain:memory",
          "@domain:session:model",
          "@domain:session:projection",
          "@domain:session:repository",
          "@domain:session:recorder",
          "@domain:skills:agent",
          "@domain:skills:definition"
        ],
        "@cli:mcp-runtime": ["@domain:mcp"],
        "@feature:unified": [
          "@domain:memory",
          "@domain:workspace",
          "@domain:web",
          "@domain:skills:agent",
          "@domain:session:repository",
          "@domain:mcp"
        ],
        "@feature:audit": ["@domain:workspace", "@domain:mcp"],
        "@feature:inspect": ["@domain:session:model"],
        "@cli:message-composer": [
          "@domain:workspace",
          "@domain:skills:agent",
          "@domain:skills:definition"
        ]
      }
    },
    "cli_arch": {
      "connect": {
        "@cli:entry": [
          "@cli:audit-run",
          "@cli:init-run",
          "@cli:inspect-run",
          "@cli:mcp-run",
          "@cli:skill-run",
          "@cli:unified-run",
          "@cli:unified-conversation",
          "@cli:bindings",
          "@cli:model-composition"
        ],
        "@cli:audit-run": ["@cli:runtime"],
        "@cli:skill-run": ["@cli:skill-runtime"],
        "@cli:unified-run": [
          "@cli:runtime",
          "@cli:message-composer",
          "@cli:submission-dispatch",
          "@cli:mcp-runtime",
          "@cli:skill-runtime",
          "@cli:unified-conversation"
        ],
        "@cli:unified-conversation": [
          "@cli:conversation-display",
          "@cli:message-composer",
          "@cli:mcp-runtime",
          "@cli:runtime",
          "@cli:skill-runtime",
          "@cli:submission-dispatch"
        ],
        "@cli:bindings": [
          "@cli:unified-run",
          "@cli:unified-conversation",
          "@cli:conversation-display",
          "@cli:message-composer",
          "@cli:interactive-shell",
          "@cli:submission-dispatch",
          "@cli:operator-decision",
          "@cli:tool-approval"
        ],
        "@cli:interactive-shell": [
          "@cli:conversation-display",
          "@cli:manager-ui",
          "@cli:operator-decision",
          "@cli:tool-approval",
          "@cli:message-composer",
          "@cli:submission-dispatch"
        ],
        "@cli:conversation-display": ["@cli:terminal-ui"],
        "@cli:manager-ui": ["@cli:terminal-ui"],
        "@cli:message-composer": ["@cli:terminal-ui"],
        "@cli:operator-decision": ["@cli:conversation-display", "@cli:terminal-ui"],
        "@cli:tool-approval": ["@cli:conversation-display", "@cli:operator-decision"]
      }
    },
    "session_arch": {
      "cascade": [
        ["@domain:session:repository", "@domain:session:recorder"],
        ["@domain:session:journal", "@domain:session:projection"],
        ["@domain:session:model"]
      ]
    },
    "skills_arch": {
      "cascade": [
        ["@domain:skills:agent"],
        ["@domain:skills:catalog"],
        ["@domain:skills:definition"]
      ],
      "sequence": [["@domain:skills:loader"], ["@domain:skills:definition"]]
    }
  },
  "rules": [
    {
      "name": "restrict-fs-access",
      "description": "Workspace domain code must access filesystem via src/shared/fs-policy",
      "match": {
        "from": "@domain:workspace",
        "to": "@ext:fs"
      },
      "severity": "error",
      "message": "Please access filesystem via src/shared/fs-policy"
    }
  ]
}
