{
  "nodes": {
    "@spec:tests": ["src/**/__tests__/**/*", "src/**/*.test.*"],
    "@cli:entry": ["src/cli/index.ts"],
    "@cli:app": ["src/cli/app/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@cli:bindings": ["src/cli/bindings/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@cli:ui": ["src/cli/ui/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@cli:prompt-editor": [
      "src/cli/prompt-editor/**/*",
      "!src/**/__tests__/**/*",
      "!src/**/*.test.*"
    ],
    "@cli:store": ["src/cli/store/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@shell": ["src/shell/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@feature:[feat]": ["src/features/[feat]/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@domain:[dom]": ["src/domains/[dom]/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@tools": ["src/tools/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@service:[svc]": ["src/services/[svc]/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@shared": ["src/shared/**/*", "!src/**/__tests__/**/*", "!src/**/*.test.*"],
    "@ext:fs": "node:fs",
    "@ext:ui": ["npm:ink", "npm:react", "npm:zustand"]
  },
  "graph": {
    "runtime_arch": {
      "cascade": [
        ["@spec:tests"],
        ["@cli:**"],
        ["@shell"],
        ["@feature:[feat]"],
        ["@tools"],
        ["@service:[svc]"],
        ["@shared"],
        ["@ext:fs"]
      ],
      "connect": {
        "@spec:tests": ["@ext:ui"],
        "@cli:**": ["@domain:[dom]"],
        "@feature:unified": [
          "@domain:workspace",
          "@domain:web",
          "@domain:skills",
          "@domain:policy",
          "@domain:capabilities"
        ],
        "@feature:audit": ["@domain:workspace", "@domain:policy"],
        "@domain:[dom]": ["@shared"],
        "@domain:skills": ["@ext:fs"],
        "@domain:session": ["@ext:fs"],
        "@cli:bindings": ["@ext:ui"],
        "@cli:ui": ["@ext:ui"],
        "@cli:prompt-editor": ["@ext:ui"],
        "@cli:store": ["@ext:ui"]
      }
    },
    "cli_arch": {
      "connect": {
        "@cli:entry": ["@cli:app", "@cli:bindings"],
        "@cli:bindings": ["@cli:ui", "@cli:store"]
      },
      "cascade": [["@cli:ui"], ["@cli:prompt-editor"], ["@cli:store"]]
    }
  },
  "rules": [
    {
      "name": "allow-unified-skill-dependency",
      "description": "Temporary exception for UnifiedAgent Skill assembly; revisit the feature graph boundary",
      "scope": "fallback",
      "match": {
        "from": "@feature:unified",
        "to": "@feature:skills"
      },
      "severity": "warn",
      "message": "UnifiedAgent currently assembles Skills directly; revisit the feature graph boundary"
    },
    {
      "name": "phase1-tools-workspace-bridge",
      "description": "Temporary while remaining workspace tools move from src/tools into @domain:workspace",
      "scope": "fallback",
      "match": {
        "from": "@tools",
        "to": "@domain:workspace"
      },
      "severity": "warn",
      "message": "Phase 1 bridge: remove after the workspace tool slice migrates"
    },
    {
      "name": "phase1-workspace-fuzzy-bridge",
      "description": "Temporary until FuzzySearchService moves into @domain:workspace",
      "scope": "fallback",
      "match": {
        "from": "@domain:workspace",
        "to": "@service:fuzzy"
      },
      "severity": "warn",
      "message": "Phase 1 bridge: move fuzzy search into the workspace domain"
    },
    {
      "name": "restrict-fs-access",
      "description": "Agent tools must access filesystem via src/shared/fs-policy",
      "match": {
        "from": "@tools",
        "to": "@ext:fs"
      },
      "severity": "error",
      "message": "Please access filesystem via src/shared/fs-policy"
    }
  ]
}
