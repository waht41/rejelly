{
  "name": "@rejelly/adapter-langchain",
  "version": "0.1.0",
  "author": "waht41",
  "description": "Convert LangChain tools to Rejelly ToolDefinition for @rejelly/core",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../../scripts/clean.mjs",
    "prepublishOnly": "node -e \"if(process.env.I_KNOW_WHAT_I_AM_DOING !== 'true') { console.error('❌ 防呆拦截：必须带上环境变量才能发布！'); process.exit(1); }\""
  },
  "keywords": [
    "rejelly",
    "adapter",
    "langchain",
    "tools"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@rejelly/core": "workspace:^",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.1",
    "@rejelly/core": "workspace:*",
    "@types/node": "catalog:",
    "lc-core-old": "npm:@langchain/core@^0.3.80",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
