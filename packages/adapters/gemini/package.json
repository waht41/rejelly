{
  "name": "@rejelly/adapter-gemini",
  "version": "0.1.0",
  "author": "waht41",
  "description": "Gemini ModelAdapter for @rejelly/core: streaming, tools, multimodal (images/videos)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../../scripts/clean.mjs",
    "prepublishOnly": "node -e \"if(process.env.I_KNOW_WHAT_I_AM_DOING !== 'true') { console.error('❌ 防呆拦截：必须带上环境变量才能发布！'); process.exit(1); }\""
  },
  "keywords": [
    "rejelly",
    "adapter",
    "gemini",
    "google",
    "llm",
    "model"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@rejelly/core": "workspace:^",
    "zod": "catalog:peer"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@rejelly/core": "workspace:*",
    "@rejelly/env": "workspace:*",
    "@rejelly/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
