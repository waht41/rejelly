# LLM Provider API Keys — fill in the key for your chosen adapter

# OpenAI (when using OpenAI adapter)
OPENAI_API_KEY=
# OPENAI_MODEL_ID=   # optional, default gpt-5.6-luna
# OPENAI_BASE_URL=   # optional, e.g. proxy or custom endpoint

# Gemini (when using Gemini adapter)
GEMINI_API_KEY=
# GEMINI_MODEL_ID=   # optional, default gemini-3.0-flash
# GOOGLE_API_KEY=    # alternative env name for Gemini
