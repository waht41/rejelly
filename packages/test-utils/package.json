{
  "name": "@rejelly/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test utilities for Rejelly adapters (e.g. adapter compliance suite)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs"
  },
  "keywords": [
    "rejelly",
    "testing",
    "adapter",
    "compliance"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@rejelly/core": "workspace:^",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@rejelly/core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
