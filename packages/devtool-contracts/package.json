{
  "name": "@rejelly/devtool-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Devtool HTTP and UI contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analyze": {
      "types": "./dist/analyze.d.ts",
      "import": "./dist/analyze.js",
      "default": "./dist/analyze.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./traces": {
      "types": "./dist/traces.d.ts",
      "import": "./dist/traces.js",
      "default": "./dist/traces.js"
    },
    "./trace-filter": {
      "types": "./dist/trace-filter.d.ts",
      "import": "./dist/trace-filter.js",
      "default": "./dist/trace-filter.js"
    },
    "./ws-protocol": {
      "types": "./dist/ws-protocol.d.ts",
      "import": "./dist/ws-protocol.js",
      "default": "./dist/ws-protocol.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rejelly",
    "devtool",
    "contracts"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
