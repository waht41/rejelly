{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "@rejelly/jelly-lint#build": {
      "outputs": ["target/release/jelly-lint*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:jelly": {
      "dependsOn": ["@rejelly/jelly-lint#build"],
      "inputs": ["src/**", "jellylint.json", "jellylint.jsonc"],
      "outputs": []
    },
    "lint:doc": {
      "outputs": []
    },
    "create-rejelly#lint:doc": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
