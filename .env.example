# Shared dev env for the whole monorepo, loaded by @rejelly/env as fallback.
# Copy to .env and fill in. Package-local .env files override these (local wins).
# Production never reads .env files — config comes from the platform environment.

# OpenAI adapter matrix profiles are opt-in. Each enabled profile must define all
# four variables below; add another profile by following the same naming scheme.
# OPENAI_TEST_PROVIDER=openai
# OPENAI_TEST_MODEL_ID=gpt-4o-mini
# OPENAI_TEST_API_KEY=
# OPENAI_TEST_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_TEST_PROVIDER=deepseek
# DEEPSEEK_TEST_MODEL_ID=deepseek-v4-flash
# DEEPSEEK_TEST_API_KEY=
# DEEPSEEK_TEST_BASE_URL=https://api.deepseek.com/v1

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.0-flash

# Set USE_PROXY=true to route outbound model traffic through PROXY_URL (undici)
USE_PROXY=false
PROXY_URL=http://127.0.0.1:7890
