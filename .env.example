# Shared dev env for the whole monorepo, loaded by @rejelly/env as fallback.
# Copy to .env and fill in. Package-local .env files override these (local wins).
# Production never reads .env files — config comes from the platform environment.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.0-flash
DEEPSEEK_API_KEY=

# Set USE_PROXY=true to route outbound model traffic through PROXY_URL (undici)
USE_PROXY=false
PROXY_URL=http://127.0.0.1:7890
